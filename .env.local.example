# ==============================================================================
# MCP SHIELD — REAL LLM RUNTIME ENVIRONMENT CONFIGURATION
# ==============================================================================
# Provide your API keys below for real in-line LLM function-calling with MCP Shield.
# If no keys are provided, MCP Shield will run using deterministic simulation fallback.
#
# NOTE: These keys are ONLY accessed by the Next.js server-side runtime and
# are NEVER exposed to the frontend/client.

# Google Gemini API Key
# Obtain free from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# OpenAI API Key (Optional)
# Obtain from: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Application Port (Default 3000)
PORT=3000
